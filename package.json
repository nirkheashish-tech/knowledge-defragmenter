{
  "name": "knowledge-defragmenter",
  "version": "1.0.0",
  "description": "Knowledge Defragmenter - An automated zero-effort synthesizer for your knowledge and voice.",
  "main": "out/main/index.js",
  "author": "Defrag",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/electron-vite/bin/electron-vite.js dev",
    "build": "npm run prisma:generate && node ./node_modules/electron-vite/bin/electron-vite.js build",
    "package": "npm run build && electron-builder --mac zip",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "clsx": "^2.1.1",
    "keytar": "^7.9.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^10.0.0",
    "zod": "^3.24.1",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "autoprefixer": "^10.4.20",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "app.defrag.synthesizer",
    "productName": "Knowledge Defragmenter",
    "asar": true,
    "asarUnpack": [
      "prisma/generated-client/**",
      "node_modules/@prisma/client/runtime/**",
      "node_modules/keytar/**/*.node"
    ],
    "files": [
      "out/**",
      "node_modules/.prisma/**",
      "node_modules/**",
      "prisma/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["zip"]
    }
  }
}
